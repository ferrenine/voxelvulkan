# Normalize: source text is LF in the index; Windows tools may write CRLF.
* text=auto

*.java    text eol=lf
*.glsl    text eol=lf
*.vert    text eol=lf
*.frag    text eol=lf
*.comp    text eol=lf
*.vsh     text eol=lf
*.fsh     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.gradle  text eol=lf
*.kts     text eol=lf
*.toml    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.cfg     text eol=lf
*.accesswidener text eol=lf

*.bat     text eol=crlf
*.cmd     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.bin     binary
*.jar     binary
*.zst     binary
*.pack    binary
